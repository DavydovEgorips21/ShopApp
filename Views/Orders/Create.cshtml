@model ShopApp.Models.Order

@{
    ViewData["Title"] = "Новый заказ";
}

<h1>Добавить заказ</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="ClientId" class="control-label">ID Клиента</label>
                <input asp-for="ClientId" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Total" class="control-label">Сумма заказа</label>
                <input asp-for="Total" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">Статус</label>
                <input asp-for="Status" class="form-control" value="paid" />
            </div>
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>